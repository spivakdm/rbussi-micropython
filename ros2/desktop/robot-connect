#!/bin/bash
set -e
source /opt/ros/jazzy/setup.bash
if [ -z "${MQTT_USER:-}" ] || [ -z "${MQTT_PASSWORD:-}" ] || [ -z "${ROBOT_NAME:-}" ]; then
    echo 'Fill in settings.env on your computer, then run docker compose up -d --force-recreate.'
    echo 'Simulation works without MQTT settings.'
    exit 1
fi
exec flock -n -E 75 /tmp/rbussi-mqtt-bridge.lock python /course/bridge.py
