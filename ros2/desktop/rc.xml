<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
 <theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout></theme>
 <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
 <desktops><number>1</number><firstdesk>1</firstdesk></desktops>
 <keyboard>
  <keybind key="C-A-t"><action name="Execute"><command>xterm -fa 'DejaVu Sans Mono' -fs 11 -bg white -fg '#142c3b' -e /course/desktop/start-terminal.sh</command></action></keybind>
 </keyboard>
 <mouse>
  <context name="Client">
   <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
  </context>
  <context name="Titlebar">
   <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
   <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
  </context>
 </mouse>
 <applications><application title="TurtleSim"><position force="yes"><x>20</x><y>45</y></position></application></applications>
</openbox_config>
